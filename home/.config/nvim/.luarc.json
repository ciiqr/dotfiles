{
    "format.enable": false,
    "runtime": {
        "version": "LuaJIT",
        "pathStrict": true
    },
    "workspace": {
        "library": [
            "${3rd}/luv/library",
            "$VIMRUNTIME",
            "~/.local/share/nvim/lazy/lazy.nvim",
            "~/.local/share/nvim/lazy/astrocore",
            "~/.local/share/nvim/lazy/astrolsp",
            "~/.local/share/nvim/lazy/astroui"
        ]
    },
    "diagnostics": {
        "globals": ["vim"],
        "disable": ["empty-block", "trailing-space"],
        "unusedLocalExclude": ["_*", "_"]
    },
    "type": {
        "checkTableShape": true
    }
}
