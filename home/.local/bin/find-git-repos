#!/usr/bin/env bash

set -e

fd \
    --hidden \
    --no-ignore \
    --type d \
    --exclude '**/target/debug/' \
    --exclude .fingerprint \
    --exclude .next \
    --exclude node_modules \
    --exclude dist \
    --exclude '**/build/Release/obj.target/' \
    --exclude '**/build/Release/.deps/' \
    --exclude .zig-cache \
    --exclude '**/.git/*' \
    --exclude .stversions \
    --exact \
    '.git' \
    "${@:-.}" \
    --exec echo '{//}'
