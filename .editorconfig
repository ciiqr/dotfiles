root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yaml,yml}]
indent_size = 2

[.gitconfig]
indent_style = tab

# TODO: shell configs (bashrc, zshrc, profiles, etc)
[{*.sh,home/.local/bin/*,bin/dev,.hooks/*}]
space_redirects = true
switch_case_indent = true

